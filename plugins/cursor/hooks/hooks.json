{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      { "command": "node ./hooks/guard.mjs pre-shell --cursor", "timeout": 15 }
    ],
    "beforeReadFile": [
      { "command": "node ./hooks/guard.mjs pre-read --cursor", "timeout": 15 }
    ],
    "preToolUse": [
      { "command": "node ./hooks/guard.mjs pre-edit --cursor", "matcher": "Write", "timeout": 15 }
    ],
    "afterFileEdit": [
      { "command": "node ./hooks/guard.mjs post-edit --cursor", "timeout": 60 }
    ]
  }
}
